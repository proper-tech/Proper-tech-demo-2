node_modules
.next
next-env.d.ts
*.tsbuildinfo

# Blender source files (too large for GitHub; ship .glb exports instead)
*.blend
*.blend1
# the interior scenes the panoramas are rendered from
!interior/*.blend

# local backups of replaced models and old scripts
*.bak
scripts/_*.py

# Python bytecode (Blender build scripts)
__pycache__/

# Interior tours: the downloaded HDRI (re-download from Poly Haven, see interior/README.md),
# test renders and render logs
interior/hdri/
interior/renders/**/_*
interior/renders/**/*.log

# Block A 1st-floor scene: 430 MB with the product scans packed in, over GitHub's file limit;
# rebuild it with interior/tools/build_a1.py (see interior/README.md)
interior/A1.blend

# The repainted panoramas the photographic tours are built from (about 110 MB; interior/tools/hd_prepare.mjs,
# hd_tours.mjs). The published tours, public/tour-hd/, are committed.
interior/hd/

# Poly Haven assets for the upgraded interiors (interior\fetch_assets.bat downloads them)
interior/assets
interior/assets.zip
interior/*_day.blend
interior/*_evening.blend

# copied from node_modules by scripts/copy-maplibre-worker.mjs
public/maplibre-gl-worker.mjs

# screenshots of the drone video marking the moments for public/views/photos (about 800 MB; photos.py)
interior/views/screenshots/
# the drone's window-view masters and season edits (about 1.6 GB of PNGs; window_views.py builds public/views from them)
interior/views/window/
